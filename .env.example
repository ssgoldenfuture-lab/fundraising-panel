# .env — JANGAN COMMIT FILE INI
SECRET_KEY=ganti_dengan_random_string_panjang
SPREADSHEET_ID=ISI_DENGAN_SPREADSHEET_ID
SHEET_NAME=rekap seluruh cs
SA_KEY_FILE=gfi-sheets-sa.json
PORT=5055
# Siapa yang boleh membuka area /database (nama + no HP donatur), selain role admin.
# Dipisah koma, mis. DB_VIEWERS=mifipsb,fitri. Kosong = hanya admin.
DB_VIEWERS=

# ── Akses ───────────────────────────────────────────────────────────────────
FAQ_REVIEWERS=admin

# ── MySQL berdonasi (dibaca berdonasi_db.py) ────────────────────────────────
BERDONASI_DB_PASS=

# ── Google / Gemini ─────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GEMINI_API_KEY=

# ── Rekap CS (/rekap) ───────────────────────────────────────────────────────
# Gemini key khusus OCR bukti transfer
REKAP_CS_API_KEY=
# URL Web App Apps Script (rekap_cs_appscript.js) — Drive + Sheet
REKAP_CS_SCRIPT_URL=
# Login CS di /rekap, format Nama:PIN dipisah koma, mis. Nabila:1234,Eka:5678
REKAP_CS_PINS=

# ── WhatsApp (Replai) ───────────────────────────────────────────────────────
REPLAI_BASE_URL=
REPLAI_API_KEY=
REPLAI_DEVICE_KEY=
REPLAI_BOT_PHONE=
REPLAI_BOT_LID=
WA_GROUP_ID=
WA_REPORT_HOUR=
